{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "constants": [
            "\u001b[37m",
            "\u001b[1;31m",
            "\u001b[1;32m",
            "\u001b[1;34m",
            "\u001b[1;33m",
            "\u001b[1;35m"
        ]
    },
    "modules": [
        "break",
        { "type": "custom", "format": "{$1}╭──────────────────────────────────╮" },
        {
            "type": "command",
            "key": "{$1}│ {$2}\uf007  User ",
            "text": "echo $USER",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "os",
            "key": "{$1}│ {$3}\uf303  OS   ",
            "format": "{$3}{pretty-name>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│ {$4}\uf2db  CPU  ",
            "text": "lscpu | grep -m1 'Model name' | grep -oE 'i[3579]-[0-9]+[A-Z]*'",
            "format": "{$4}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│ {$5}\udb82\udcae  GPU  ",
            "text": "lspci | grep -oE 'GTX [0-9]+( Ti)?' | head -1",
            "format": "{$5}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│ {$6}\udb80\udf5b  RAM  ",
            "text": "free -m | awk 'NR==2{printf \"%.1f GiB / %.1f GiB\",$3/1024,$2/1024}'",
            "format": "{$6}{>22}{$1} │"
        },
        { "type": "custom", "format": "{$1}╰──────────────────────────────────╯" },
        "break"
    ]
}
